rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Entry photos, uploaded as checkins/{userId}/{placeID}_{index}.jpg
    // (EntryService.uploadImage). Only the owner writes them; any signed-in user
    // can read, because a photo on a public entry is surfaced to other users
    // through places/{placeID}.publicImageURLs.
    match /checkins/{userId}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is closed. Replaces the default test rule, which granted
    // the whole bucket to anyone until it expired on 2026-12-31.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
